SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=15
PAIRING_CODE_EXPIRE_MINUTES=10
# Copy the pooled connection string from Neon and keep its TLS parameters.
DATABASE_URL=

# Local Redis on the backend machine
REDIS_URL=redis://127.0.0.1:6379/0
# Comma-separated origins for browser clients. Native clients do not use CORS.
CORS_ORIGINS=
